#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>



/ {

    behaviors {

        // Macro to clear current BT profile (tap)
        bt_clear_current_macro: bt_clear_current_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_CLR>;
        };

        // Macro to clear all BT profiles (hold)
        bt_clear_all_macro: bt_clear_all_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_CLR_ALL>;
        };

        // Hold to clear all BT profiles, Tap to clear current
        bt_clear_holdtap: bt_clear_holdtap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <3000>;
            bindings = <&bt_clear_all_macro>, <&bt_clear_current_macro>;
        };

        // Default mod-tap — hold-preferred, 200ms
        ht_def: ht_def {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&kp>;
        };

        // Fast mod-tap — balanced, 150ms, quick-tap 100ms
        ht_fast: ht_fast {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <150>;
            quick-tap-ms = <100>;
            bindings = <&kp>, <&kp>;
        };

        // Slow layer-tap — tap-preferred, 280ms, retro-tap on
        ht_slow: ht_slow {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <280>;
            retro-tap;
            bindings = <&mo>, <&kp>;
        };

        // User slots — default to hold-preferred 200ms, tweak in Studio
        ht_user1: ht_user1 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&kp>;
        };

        ht_user2: ht_user2 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&kp>;
        };

        ht_user3: ht_user3 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&kp>;
        };

        ht_user4: ht_user4 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&kp>;
        };

    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp ESC   &kp N1 &kp N2 &kp N3 &kp N4 &kp N5 &kp N6 &kp N7 &kp N8    &kp N9    &kp N0    &kp MINUS &kp EQUAL   &kp GRAVE  &kp BSLH
&kp TAB   &kp Q  &kp W  &kp E  &kp R  &kp T  &kp Y  &kp U  &kp I     &kp O     &kp P     &kp LBKT  &kp RBKT               &kp BSPC
&kp LCTRL &kp A  &kp S  &kp D  &kp F  &kp G  &kp H  &kp J  &kp K     &kp L     &kp SEMI  &kp SQT   &kp RET
&kp LSHFT &trans &kp Z  &kp X  &kp C  &kp V  &kp B  &kp N  &kp M     &kp COMMA &kp DOT   &kp SLASH &kp RSHFT  &mo 1
&kp LALT &kp LGUI &kp SPACE &mo 1 &kp SPACE &kp RGUI &kp RALT
&trans &trans &trans
            >;
        };

        function_layer {
            display-name = "Function";
            bindings = <
&kp C_PWR &kp F1       &kp F2       &kp F3     &kp F4      &kp F5   &kp F6          &kp F7      &kp F8     &kp F9    &kp F10         &kp F11   &kp F12 &kp DEL   &kp INS
&kp CAPS  &kp C_BRI_UP &kp C_BRI_DN &trans     &sys_reset  &trans   &trans          &trans      &kp PSCRN  &kp SLCK  &kp PAUSE_BREAK &kp UP    &trans  &kp DEL
&trans    &kp C_VOL_UP &kp C_VOL_DN &kp C_MUTE &kp C_EJECT &trans   &kp KP_MULTIPLY &kp FSLH    &kp HOME   &kp PG_UP &kp LEFT        &kp RIGHT &trans
&trans    &trans       &kp C_PREV   &kp C_NEXT &kp C_PP    &kp C_STOP &mo 2         &kp KP_PLUS &kp MINUS  &kp END   &kp PG_DN       &kp DOWN  &trans  &trans
&trans    &trans       &trans       &trans     &trans      &trans   &trans
&trans &trans &trans
            >;
        };

        bluetooth_layer {
            display-name = "Bluetooth";
            bindings = <
&trans       &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &bt_clear_holdtap 0 0  &trans
&out OUT_TOG &trans        &trans        &trans        &bootloader   &trans        &trans  &trans  &trans  &trans  &trans  &trans  &trans  &studio_unlock
&trans       &trans        &trans        &trans        &trans        &trans        &trans  &trans  &trans  &trans  &trans  &trans          &soft_off
&trans       &trans        &trans        &trans        &trans        &trans        &trans  &trans  &trans  &trans  &trans  &trans          &trans  &trans
&trans       &trans        &trans        &trans        &trans        &trans        &trans
&trans &trans &trans
            >;
        };

        extra1 {
            display-name = "Extra 1";
            status = "reserved";
        };

        extra2 {
            display-name = "Extra 2";
            status = "reserved";
        };
    };
};
