+#define ADV_RETRY_MIN_MS 100
+#define ADV_RETRY_MAX_MS 1000
+
+static atomic_t advertising_update_running;
+static atomic_t advertising_retry_delay_ms = ADV_RETRY_MIN_MS;
+static void advertising_retry_callback(struct k_work *work);
+static K_WORK_DELAYABLE_DEFINE(advertising_retry_work, advertising_retry_callback);
+
+int update_advertising(void) {
+    // A retry can overlap a profile update from the Bluetooth/Studio thread.
+    // Do not wait on a mutex here: the current attempt may itself need that
+    // thread to process an HCI response. Re-evaluate the latest profile later.
+    if (!atomic_cas(&advertising_update_running, 0, 1)) {
+        k_work_schedule(&advertising_retry_work, K_MSEC(ADV_RETRY_MIN_MS));
+        return 0;
+    }
+
+    int err = update_advertising_once();
+    if (err == -ENOMEM || err == -ENOBUFS || err == -EAGAIN || err == -EBUSY) {
+        // ONE_TIME advertising is not restarted by Zephyr when the last
+        // reference to a disconnected connection is released. That reference
+        // can outlive disconnected(), so keep trying after resources recover.
+        int delay = atomic_get(&advertising_retry_delay_ms);
+        atomic_set(&advertising_retry_delay_ms, MIN(delay * 2, ADV_RETRY_MAX_MS));
+        k_work_schedule(&advertising_retry_work, K_MSEC(delay));
+    } else {
+        atomic_set(&advertising_retry_delay_ms, ADV_RETRY_MIN_MS);
+    }
+
+    // Leave an already queued update intact: it may have been requested by a
+    // concurrent profile/connection change while the stack call was running.
+    // A successful retry does not schedule another pass.
+    atomic_clear(&advertising_update_running);
+    return err;
+}
+
+static void advertising_retry_callback(struct k_work *work) { update_advertising(); }
+
 static void update_advertising_callback(struct k_work *work) { update_advertising(); }
 
 K_WORK_DEFINE(update_advertising_work, update_advertising_callback);
